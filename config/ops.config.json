{
  "readiness": {
    "checkTimeoutMs": 2000
  },
  "requestId": {
    "maxLength": 128
  },
  "productionEnv": {
    "minJwtSecretLength": 32,
    "forbiddenJwtSecrets": [
      "ci-test-only-jwt-secret-never-use-in-production"
    ]
  },
  "clientErrors": {
    "maxMessageLength": 500,
    "maxPathLength": 200,
    "maxDigestLength": 64
  }
}
