{
  "email": { "maxLength": 254 },
  "password": {
    "minLength": 8,
    "maxLength": 128
  },
  "scrypt": {
    "cost": 16384,
    "blockSize": 8,
    "parallelization": 1,
    "keyLength": 64,
    "saltBytes": 16
  },
  "passwordReset": {
    "tokenTtlMinutes": 30,
    "tokenBytes": 32,
    "minIntervalSeconds": 60
  },
  "session": {
    "accessTokenTtlSeconds": 3600,
    "refreshTokenTtlDays": 30,
    "refreshTokenBytes": 32,
    "maxActiveSessionsPerPlayer": 20,
    "userAgentMaxLength": 200
  },
  "emailVerification": { "tokenTtlHours": 48, "tokenBytes": 32, "minIntervalSeconds": 60 }
}
