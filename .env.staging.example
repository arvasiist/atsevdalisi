# STAGING ortam değişkenleri (02.10.2026, Faz 13-C). Kopyala: .env.staging
# (gitignore'lu). GERÇEK değerleri BURAYA yazma — bu dosya depodadır.
POSTGRES_USER=at_sevdalisi
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=at_sevdalisi
# En az 32 karakter: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
# Tarayıcının gördüğü adresler (localhost OLAMAZ — üretim ortam kapısı).
PUBLIC_WEB_URL=https://staging.alan-adiniz.com
PUBLIC_API_URL=https://api.staging.alan-adiniz.com/api/v1
# E-posta + Google girişi (isteğe bağlı) — bkz. docs/EPOSTA_GOOGLE_KURULUM.md.
# RESEND_API_KEY verilirse MAIL_FROM ZORUNLU ("Ad <adres@dogrulanmis-alan.com>").
RESEND_API_KEY=
MAIL_FROM=
# Yalnızca istemci KİMLİĞİ (….apps.googleusercontent.com); sır (GOCSPX-…) değil.
GOOGLE_OAUTH_CLIENT_ID=
# İzleme (isteğe bağlı): /metrics token'ı (≥24 karakter) ve alarm webhook'u (https).
METRICS_TOKEN=
ALERT_WEBHOOK_URL=
API_PORT=4000
WEB_PORT=3000
