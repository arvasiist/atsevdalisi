{
  "name": "@at-sevdalisi/api",
  "version": "0.1.0",
  "private": true,
  "description": "AT SEVDALISI backend (NestJS) - bkz. docs/ARCHITECTURE.md §6",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:domain": "tsc -p tsconfig.domain.json",
    "test": "vitest run --passWithNoTests --no-file-parallelism",
    "migrate": "tsx ../../tools/migrate.ts up",
    "migrate:undo": "tsx ../../tools/migrate.ts down",
    "seed": "tsx ../../tools/seed.ts"
  },
  "dependencies": {
    "@at-sevdalisi/game-config": "*",
    "@at-sevdalisi/shared-types": "*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/websockets": "^11.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "google-auth-library": "^9.14.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "socket.io-client": "^4.7.5",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
