# Sunucu
# NODE_ENV=production iken eksik/zayıf ortam değişkeniyle uygulama AÇILMAZ:
# JWT_SECRET, DATABASE_URL, REDIS_URL, CORS_ORIGIN ve WEB_BASE_URL (localhost
# olamaz) zorunlu; DISABLE_RATE_LIMIT=true YASAK. Sahte para yatırma üretimde
# her zaman kapalıdır.
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Veritabanı (bkz. docs/DATABASE.md)
DATABASE_URL=postgres://at_sevdalisi:at_sevdalisi@localhost:5432/at_sevdalisi

# Cache / Session (bkz. docs/ARCHITECTURE.md §6, brief §78)
REDIS_URL=redis://localhost:6379

# Kimlik doğrulama (brief §50 /api/auth/*)
# ÜRETİMDE en az 32 karakter, rastgele (örn. `openssl rand -base64 48`).
# Eksik/kısa/bilinen test değeriyse uygulama AÇILMAZ (production-env.ts).
# Erişim/yenileme token süreleri config/auth.config.json → session'dadır.
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# İdempotency (brief §54)
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# Google ile giriş (01.10.2026) — Google Cloud Console → API'ler ve Hizmetler →
# Kimlik bilgileri → OAuth istemci kimliği (Web uygulaması). "Yetkili JavaScript
# kaynakları"na web adresini ekleyin. Boşsa Google düğmesi GÖSTERİLMEZ.
GOOGLE_OAUTH_CLIENT_ID=
# Apple ile giriş — henüz istemci yok (ücretli Apple Developer üyeliği gerekir).
APPLE_OAUTH_CLIENT_ID=

# Şifre sıfırlama e-postası (30.09.2026) — https://resend.com
# Boş bırakılırsa e-posta GÖNDERİLMEZ (geliştirmede konsola yazılır).
RESEND_API_KEY=
MAIL_FROM=At Sevdalısı <no-reply@alan-adiniz.com>
# E-postadaki sıfırlama bağlantısının kökü (web uygulaması adresi)
WEB_BASE_URL=http://localhost:3000
