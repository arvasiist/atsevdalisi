# Sunucu
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Veritabanı (bkz. docs/DATABASE.md)
DATABASE_URL=postgres://at_sevdalisi:at_sevdalisi@localhost:5432/at_sevdalisi

# Cache / Session (bkz. docs/ARCHITECTURE.md §6, brief §78)
REDIS_URL=redis://localhost:6379

# Kimlik doğrulama (brief §50 /api/auth/*)
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# İdempotency (brief §54)
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# Şifre sıfırlama e-postası (30.09.2026) — https://resend.com
# Boş bırakılırsa e-posta GÖNDERİLMEZ (geliştirmede konsola yazılır).
RESEND_API_KEY=
MAIL_FROM=At Sevdalısı <no-reply@alan-adiniz.com>
# E-postadaki sıfırlama bağlantısının kökü (web uygulaması adresi)
WEB_BASE_URL=http://localhost:3000
